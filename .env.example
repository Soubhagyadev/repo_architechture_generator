# Copy to .env and fill in what you use. All keys are optional; missing ones
# disable the corresponding provider and the tool falls back to deterministic
# (LLM-free) analysis outputs.

# GitHub token: raises API rate limits (60 -> 5000 req/h). Recommended.
GITHUB_TOKEN=

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (OpenAI-compatible): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional default model for OpenRouter:
OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=gsk_...your-groq-key...
# Optional model override (default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Explicit config file location (defaults: REPO_ANALYZER_CONFIG, then ./repo_analyzer.toml)
# REPO_ANALYZER_CONFIG=/path/to/config.example.toml
# Alternative provider selection without a config file: gemini | openrouter | groq
# REPO_ANALYZER_PROVIDER=gemini
